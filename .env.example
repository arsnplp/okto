# ---------- Base ----------
PORT=3000
# Adresse publique d'Okto (sans / final). En local : http://localhost:3000
BASE_URL=http://localhost:3000
# 1 = active le simulateur /dev (messages affichés dans le navigateur). Mettre 0 en production.
DEV_MODE=1
# Phrase secrète qui chiffre les jetons stockés. Longue et aléatoire en production.
SECRET_KEY=
TIMEZONE=Europe/Paris
# Fréquence de synchronisation des sources, en minutes
SYNC_MINUTES=30

# ---------- Moodle ----------
MOODLE_URL=https://learning.devinci.fr

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Chaîne de ton choix, à recopier dans la config du webhook chez Meta
WHATSAPP_VERIFY_TOKEN=
# "App secret" de l'appli Meta, sert à vérifier que les webhooks viennent bien de Meta
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v26.0
# Nom du modèle de message approuvé pour les rappels hors fenêtre de 24 h (corps : "Okto : {{1}}")
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=fr
# Numéro d'Okto au format international sans + (sert au lien wa.me de la page d'accueil)
WHATSAPP_NUMBER=
# Optionnel : numéros autorisés, séparés par des virgules (ex : 33614380522). Vide = ouvert à tous.
ALLOWED_NUMBERS=

# ---------- Google Agenda ----------
# URI de redirection à déclarer : BASE_URL/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Microsoft (Outlook + Teams) ----------
# URI de redirection à déclarer : BASE_URL/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=organizations
# 1 = demande aussi l'accès aux devoirs Teams (nécessite l'accord de l'admin de l'école)
MS_EDU=0

# ---------- IA (optionnel) ----------
# Sert à extraire titre et date limite des mails Outlook. Sans clé, les mails suspects sont listés "à vérifier".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
